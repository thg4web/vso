# Only what Hugo needs to build and display the site gets pushed here.
# Everything project-related (scripts, docs, planning, third-party tools)
# stays local -- gitignored on purpose, not an oversight.

public/
resources/
.hugo_build.lock
.DS_Store
.env
/exports/
# static/data/ and static/exports/ ARE tracked -- they're the generated
# rise/set and 24h-log data the live site reads at runtime. ebench's cron
# pushes fresh copies here daily after regenerating them; that push is what
# triggers the GitHub Pages rebuild.
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
__pycache__/
*.pyc

# Project-management / tooling -- not site content.
CLAUDE.md
document-skel.md
archive/
project/
scripts/
start_webserver.sh
