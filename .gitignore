# Only what Hugo needs to build and display the site gets pushed here.
# Everything project-related (scripts, docs, planning, third-party tools)
# stays local -- gitignored on purpose, not an oversight.

public/
resources/
.hugo_build.lock
.DS_Store
.env
/exports/
# Generated data lives on the separate `data` branch (written only by ebench);
# the deploy workflow overlays it at build time. These local copies come from
# scripts/sync_data.sh and are never committed from here.
/data/tcrb_observations.json
/static/data/
/static/exports/
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
__pycache__/
*.pyc

